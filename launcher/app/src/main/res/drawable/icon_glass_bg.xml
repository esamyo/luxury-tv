<?xml version="1.0" encoding="utf-8"?>
<!-- Icon-only top buttons: nothing around the icon until focused, then a soft white glow behind it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="21dp"
                android:startColor="#59FFFFFF" android:centerColor="#1FFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
