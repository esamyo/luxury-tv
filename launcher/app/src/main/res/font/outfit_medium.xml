<?xml version="1.0" encoding="utf-8"?>
<!-- The UI font (Vazirmatn, Arabic and Latin) at weight 400 (the bundled font covers weights 200 to 400), built once per process. android:fontVariationSettings on each TextView rebuilt
     the variable font for every view (about 10 ms each on a TV CPU). Android 8 ignores the weight here, as
     it did on the views, and draws the default instance. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/vazirmatn"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        tools:targetApi="28" />
</font-family>
